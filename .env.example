# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or share it with anyone.

# ---- Database (XAMPP defaults: user "root", empty password) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=party_booking
DB_USER=root
DB_PASS=

# ---- Gmail SMTP (use a Google App Password, NOT your normal Gmail password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_FROM_NAME="Caroline's Party Helper"

# ---- Where booking notifications are delivered (your Gmail inbox) ----
ADMIN_EMAIL=yourgmail@gmail.com

# ---- Website ----
# The public address of this site WITHOUT a trailing slash.
# XAMPP example:      http://localhost/party-booking-system
# Production example: https://www.yourdomain.com
APP_URL=http://localhost/party-booking-system

# "local" while testing, "production" when live (hides detailed errors)
APP_ENV=local

# Time zone used for booking dates, times and link expiry
# (list: https://www.php.net/manual/en/timezones.php)
APP_TIMEZONE=America/New_York
