# Apache settings (works with XAMPP when mod_rewrite is enabled - it is by default).

Options -Indexes
DirectoryIndex index.php

# Block direct web access to private folders and files.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|includes|database|scripts|vendor)(/|$) - [F,L]

  # PRODUCTION ONLY: remove the "#" from the 3 lines below to force HTTPS.
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP_HOST} !^localhost [NC]
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<FilesMatch "(^\.|\.(env|sql|json|lock|md|log|ini|sh)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
